diff --git a/tests/test_fb_display.py b/tests/test_fb_display.py
new file mode 100644
index 0000000..c51ac6e
--- /dev/null
+++ b/tests/test_fb_display.py
@@ -0,0 +1,240 @@
+"""FBDisplay — geometry from sysfs, pixel packing, and refusing to fake it.
+
+No hardware: a fixture builds a sysfs tree and a file the size of the panel's
+memory, and FBDisplay maps that.  mmap on a regular file behaves like mmap on a
+framebuffer for everything these tests assert (offsets, stride, packing), so the
+byte layout checked here is the layout a real panel receives.
+
+    pytest tests/test_fb_display.py
+"""
+
+import numpy as np
+import pytest
+
+from drm_display import fb_display
+from drm_display.fb_display import FBDisplay
+from drm_display.screen import Screen
+from drm_display.db_display import DBDisplay
+
+
+@pytest.fixture
+def panel(tmp_path, monkeypatch):
+    """Build a fake framebuffer; returns a factory -> (device_path, FBDisplay)."""
+    monkeypatch.setattr(fb_display, "SYSFS_ROOT", str(tmp_path / "sys"))
+
+    def make(width=8, height=4, bpp=16, stride=None, name="fb_ili9486",
+             node="fb1", create=True, attrs=True):
+        stride = stride if stride is not None else width * bpp // 8
+        if attrs:
+            sysfs = tmp_path / "sys" / node
+            sysfs.mkdir(parents=True)
+            (sysfs / "virtual_size").write_text(f"{width},{height}\n")
+            (sysfs / "bits_per_pixel").write_text(f"{bpp}\n")
+            (sysfs / "stride").write_text(f"{stride}\n")
+            (sysfs / "name").write_text(f"{name}\n")
+        dev = tmp_path / "dev" / node
+        dev.parent.mkdir(parents=True, exist_ok=True)
+        if create:
+            dev.write_bytes(b"\x00" * (stride * height))
+        return str(dev)
+
+    return make
+
+
+def _bgra(h, w, b, g, r, a=255):
+    canvas = np.zeros((h, w, 4), np.uint8)
+    canvas[..., 0], canvas[..., 1], canvas[..., 2], canvas[..., 3] = b, g, r, a
+    return canvas
+
+
+# ── it refuses to invent a display ───────────────────────────────────────────
+
+def test_missing_device_raises_instead_of_faking_1920x1080(panel):
+    # the old behaviour: unreadable sysfs -> 1920x1080 -> a mmap that fails ->
+    # a numpy array in RAM -> "Display: /dev/fb0 (1920x1080)" and a black panel
+    dev = panel(create=False, attrs=False)
+    with pytest.raises(OSError, match="does not exist, or is not a framebuffer"):
+        FBDisplay(dev)
+
+
+def test_device_node_absent_raises(panel):
+    dev = panel(create=False)                 # sysfs present, device file gone
+    with pytest.raises(OSError, match="cannot map"):
+        FBDisplay(dev)
+
+
+def test_non_framebuffer_path_rejected():
+    with pytest.raises(ValueError, match="not a framebuffer device node"):
+        FBDisplay("/dev/dri/card0")
+
+
+def test_unsupported_depth_rejected(panel):
+    dev = panel(bpp=8, stride=8)
+    with pytest.raises(ValueError, match="8 bits per pixel is not supported"):
+        FBDisplay(dev)
+
+
+def test_stride_smaller_than_a_row_rejected(panel):
+    dev = panel(width=8, bpp=16, stride=4)    # 8px at 16bpp needs 16 bytes
+    with pytest.raises(ValueError, match="stride 4 is too small"):
+        FBDisplay(dev)
+
+
+# ── geometry ─────────────────────────────────────────────────────────────────
+
+def test_reads_geometry_depth_and_driver_from_sysfs(panel):
+    dev = panel(width=480, height=320, bpp=16, name="fb_ili9486")
+    fb = FBDisplay(dev)
+    assert (fb.screen_width, fb.screen_height) == (480, 320)
+    assert fb.bpp == 16 and fb.bytes_per_pixel == 2
+    assert fb.stride == 960
+    assert fb.driver == "fb_ili9486"          # tells fbtft apart from vc4drmfb
+    fb.close()
+
+
+def test_explicit_size_overrides_sysfs(panel):
+    dev = panel(width=8, height=4, bpp=32, stride=32)
+    fb = FBDisplay(dev, width=8, height=2)    # panel lies about virtual height
+    assert (fb.screen_width, fb.screen_height) == (8, 2)
+    fb.close()
+
+
+# ── packing ──────────────────────────────────────────────────────────────────
+
+def test_rgb565_packs_channels_into_the_right_bits():
+    pack = FBDisplay._rgb565
+    assert pack(_bgra(1, 1, 0, 0, 255))[0, 0] == 0xF800      # red
+    assert pack(_bgra(1, 1, 0, 255, 0))[0, 0] == 0x07E0      # green
+    assert pack(_bgra(1, 1, 255, 0, 0))[0, 0] == 0x001F      # blue
+    assert pack(_bgra(1, 1, 255, 255, 255))[0, 0] == 0xFFFF  # white
+    assert pack(_bgra(1, 1, 0, 0, 0))[0, 0] == 0x0000        # black
+
+
+def test_16bpp_writes_little_endian_pairs(panel):
+    dev = panel(width=2, height=1, bpp=16)
+    fb = FBDisplay(dev)
+    fb.send_full_image(_bgra(1, 2, 0, 0, 255))               # two red pixels
+    fb.fb.flush()
+    # 0xF800 little-endian is 00 F8
+    assert bytes(open(dev, "rb").read(4)) == b"\x00\xf8\x00\xf8"
+    fb.close()
+
+
+def test_32bpp_writes_bgra_untouched(panel):
+    dev = panel(width=2, height=1, bpp=32, stride=8)
+    fb = FBDisplay(dev)
+    fb.send_full_image(_bgra(1, 2, 1, 2, 3, 4))
+    fb.fb.flush()
+    assert bytes(open(dev, "rb").read(8)) == bytes([1, 2, 3, 4, 1, 2, 3, 4])
+    fb.close()
+
+
+def test_24bpp_drops_alpha(panel):
+    dev = panel(width=2, height=1, bpp=24, stride=6)
+    fb = FBDisplay(dev)
+    fb.send_full_image(_bgra(1, 2, 1, 2, 3, 255))
+    fb.fb.flush()
+    assert bytes(open(dev, "rb").read(6)) == bytes([1, 2, 3, 1, 2, 3])
+    fb.close()
+
+
+# ── stride and clipping ──────────────────────────────────────────────────────
+
+def test_line_padding_is_never_written(panel):
+    # 4px at 16bpp = 8 bytes of pixels, but the line is 12 bytes long
+    dev = panel(width=4, height=2, bpp=16, stride=12)
+    with open(dev, "wb") as fh:
+        fh.write(b"\xAA" * 24)                # poison, including the padding
+    fb = FBDisplay(dev)
+    fb.send_full_image(_bgra(2, 4, 255, 255, 255))
+    fb.fb.flush()
+    raw = open(dev, "rb").read()
+    for row in (0, 1):
+        line = raw[row * 12:(row + 1) * 12]
+        assert line[:8] == b"\xff" * 8, "pixels not written"
+        assert line[8:] == b"\xAA" * 4, "padding bytes were overwritten"
+    fb.close()
+
+
+def test_partial_update_touches_only_its_rect(panel):
+    dev = panel(width=4, height=4, bpp=16)
+    fb = FBDisplay(dev)
+    fb.clear()
+    fb.send_partial_image(_bgra(2, 2, 255, 255, 255), x=2, y=1)
+    fb.fb.flush()
+    seen = np.frombuffer(open(dev, "rb").read(), np.uint16).reshape(4, 4)
+    expected = np.zeros((4, 4), np.uint16)
+    expected[1:3, 2:4] = 0xFFFF
+    assert np.array_equal(seen, expected)
+    fb.close()
+
+
+def test_oversized_canvas_is_clipped_not_an_error(panel):
+    dev = panel(width=4, height=2, bpp=16)
+    fb = FBDisplay(dev)
+    fb.send_full_image(_bgra(10, 10, 255, 255, 255))      # bigger than the panel
+    fb.fb.flush()
+    assert len(open(dev, "rb").read()) == 16              # nothing grew
+    fb.close()
+
+
+def test_fully_offscreen_blit_is_a_noop(panel):
+    dev = panel(width=4, height=2, bpp=16)
+    fb = FBDisplay(dev)
+    fb.send_partial_image(_bgra(2, 2, 255, 255, 255), x=99, y=99)
+    fb.fb.flush()
+    assert set(open(dev, "rb").read()) == {0}
+    fb.close()
+
+
+def test_writing_after_close_is_an_error_not_a_silent_noop(panel):
+    fb = FBDisplay(panel())
+    fb.close()
+    with pytest.raises(RuntimeError, match="closed"):
+        fb.send_full_image(_bgra(1, 1, 0, 0, 0))
+
+
+# ── Screen dispatch ──────────────────────────────────────────────────────────
+
+def test_screen_opens_a_named_framebuffer_that_is_not_fb0(panel):
+    dev = panel(width=8, height=4, bpp=16, node="fb1")
+    screen = Screen(device=dev)               # the case that used to be unreachable
+    assert isinstance(screen.display, FBDisplay)
+    assert screen.get_screen_size() == (8, 4)
+    screen.close()
+
+
+def test_screen_raises_the_real_error_for_a_named_device(panel):
+    dev = panel(create=False)
+    with pytest.raises(OSError, match="cannot map"):
+        Screen(device=dev)                    # not "No suitable display backend"
+
+
+def test_backend_for_maps_paths_to_classes():
+    from drm_display.drm_display import DRMDisplay
+    assert Screen.backend_for("/dev/dri/card1") is DRMDisplay
+    assert Screen.backend_for("/dev/fb7") is FBDisplay
+    assert Screen.backend_for("dummy") is DBDisplay
+    with pytest.raises(ValueError, match="cannot tell which backend"):
+        Screen.backend_for("/dev/sda")
+
+
+def test_autodetect_enumerates_every_card_and_fb(monkeypatch):
+    import drm_display.screen as screen_mod
+    from drm_display.drm_display import DRMDisplay
+    monkeypatch.setattr(screen_mod.glob, "glob", lambda pattern: {
+        "/dev/dri/card*": ["/dev/dri/card1", "/dev/dri/card0"],
+        "/dev/fb*": ["/dev/fb1", "/dev/fb0"],
+    }[pattern])
+    assert Screen._autodetect() == [
+        ("/dev/dri/card0", DRMDisplay), ("/dev/dri/card1", DRMDisplay),
+        ("/dev/fb0", FBDisplay), ("/dev/fb1", FBDisplay),
+        ("dummy", DBDisplay),
+    ]
+
+
+def test_dummy_fallback_is_announced(monkeypatch, capsys):
