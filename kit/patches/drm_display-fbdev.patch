+
+    def send_partial_image(self, data, x=0, y=0):
+        """Blit a BGRA region at (x, y).
+
+        Partial writes are what make an SPI panel bearable: there the bus, not
+        the CPU, is the bottleneck, and fbtft's deferred IO only pushes out the
+        pages that were actually touched.
+        """
+        if self.fb is None:
+            raise RuntimeError(f"{self.display} is closed")
+        x, y = max(0, int(x)), max(0, int(y))
+        h = min(data.shape[0], self.screen_height - y)
+        w = min(data.shape[1], self.screen_width - x)
+        if h <= 0 or w <= 0:
+            return
+        bp = self.bytes_per_pixel
+        # Write a column slice of the mapped rows: everything outside the rect,
+        # line padding included, is left exactly as it was.
+        self.fb[y:y + h, x * bp:(x + w) * bp] = self._pack(data[:h, :w])
+
+    def clear(self):
+        if self.fb is not None:
+            self.fb[:] = 0
+
