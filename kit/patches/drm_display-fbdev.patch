+"""Framebuffer backend — render to any ``/dev/fbN``.
+
+Reads the panel's real geometry, colour depth and line stride from sysfs and
+packs each frame into the format the device actually wants.  That makes the
+cheap 16-bit SPI TFTs usable (ILI9486 / ILI9341 / ST7735 under ``fbtft``, which
+land on ``/dev/fb1`` at RGB565) alongside the 32-bit fbdev emulation a KMS
+driver exposes as ``/dev/fb0``.
+
+Deliberately strict: if the device is missing, unreadable, or in a format this
+backend cannot pack, the constructor **raises**.  A display backend that
+silently succeeds is worse than no backend at all — it renders an entire
+session into anonymous memory and looks exactly like dead hardware.
+``DBDisplay`` is the only backend allowed to always work, and you have to ask
+for it by name.
+
+Byte order is assumed little-endian (Raspberry Pi, x86): the 16-bit packer
+writes the low byte first, which is what an RGB565 framebuffer expects there.
+"""
+
+import os
+
 import numpy as np
 
+#: Where the kernel publishes framebuffer geometry.  Module level so tests can
+#: point it at a fixture tree.
+SYSFS_ROOT = "/sys/class/graphics"
+
+#: Colour depths this backend can pack a BGRA canvas into.
+SUPPORTED_BPP = (16, 24, 32)
+
 
 class FBDisplay(object):
+    """A memory-mapped ``/dev/fbN``.
+
+    Canvases are BGRA ``(H, W, 4)`` uint8 — the canonical layout everywhere in
+    this package — and are converted here to whatever the panel runs at.
+    """
+
