+            raise ValueError(f"{display!r} is not a framebuffer device node")
+
+        sysfs_w, sysfs_h = self.get_screen_size(display)
+        # width/height override what sysfs reports — an escape hatch for panels
+        # whose virtual size is not their visible size.  Normally leave them None.
+        self.screen_width = int(width or sysfs_w)
+        self.screen_height = int(height or sysfs_h)
