+    @staticmethod
+    def backend_for(device):
+        """Which backend class drives `device`."""
+        if str(device).startswith("/dev/dri/"):
+            return DRMDisplay
+        if os.path.basename(str(device)).startswith("fb"):
+            return FBDisplay
+        if device == "dummy":
+            return DBDisplay
+        raise ValueError(
+            f"cannot tell which backend {device!r} needs — expected "
+            f"/dev/dri/cardN, /dev/fbN, or 'dummy'")
+
+    @staticmethod
+    def _autodetect():
+        """Every device worth trying, best first."""
+        found = [(p, DRMDisplay) for p in sorted(glob.glob("/dev/dri/card*"))]
+        found += [(p, FBDisplay) for p in sorted(glob.glob("/dev/fb*"))]
+        return found + [("dummy", DBDisplay)]
+
