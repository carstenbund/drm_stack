+    @staticmethod
+    def _rgb565(bgra):
+        """BGRA uint8 -> RGB565 uint16 (5 bits red, 6 green, 5 blue)."""
+        b = bgra[..., 0].astype(np.uint16)
+        g = bgra[..., 1].astype(np.uint16)
+        r = bgra[..., 2].astype(np.uint16)
+        return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3)
+
+    def _pack(self, bgra):
+        """BGRA -> the device's format, contiguous, (h, w * bytes_per_pixel)."""
+        h, w = bgra.shape[:2]
+        if self.bpp == 32:
+            return np.ascontiguousarray(bgra[..., :4]).reshape(h, w * 4)
+        if self.bpp == 24:
+            return np.ascontiguousarray(bgra[..., :3]).reshape(h, w * 3)
+        # 16bpp: .view() lays each pixel down low byte first (little-endian)
+        return np.ascontiguousarray(self._rgb565(bgra)).view(np.uint8).reshape(h, w * 2)
+
